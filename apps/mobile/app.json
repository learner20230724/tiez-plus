{
  "expo": {
    "name": "TIEZ Plus",
    "slug": "tiez-plus",
    "version": "0.1.1",
    "scheme": "tiezplus",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.learner20230724.tiezplus",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "scanner",
            "UIApplicationShortcutItemTitle": "文件传输",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCaptureVideo",
            "UIApplicationShortcutItemUserInfo": {
              "url": "tiezplus://scanner"
            }
          },
          {
            "UIApplicationShortcutItemType": "pull",
            "UIApplicationShortcutItemTitle": "获取 PC 内容",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCloudDownload",
            "UIApplicationShortcutItemUserInfo": {
              "url": "tiezplus://sync-pull"
            }
          },
          {
            "UIApplicationShortcutItemType": "push",
            "UIApplicationShortcutItemTitle": "同步到 PC",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeShare",
            "UIApplicationShortcutItemUserInfo": {
              "url": "tiezplus://sync-push"
            }
          }
        ]
      }
    },
    "android": {
      "package": "io.github.learner20230724.tiezplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 TIEZ Plus 使用相机进行扫码、拍照和录像。",
          "microphonePermission": "允许 TIEZ Plus 使用麦克风录制视频声音。"
        }
      ],
      "expo-video",
      "./plugins/withAndroidTile",
      "./plugins/withAndroidShortcuts",
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": [
              "arm64-v8a"
            ],
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "./plugins/withPlusDiscovery",
      "./plugins/withPlusSigning"
    ]
  }
}
